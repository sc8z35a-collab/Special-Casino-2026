# Response headers for the static game files on Cloudflare (the page itself
# gets its headers from server/cloudflare/worker.js).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
/sw.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/download/*
  Cache-Control: no-cache
/download/*.apk
  Content-Disposition: attachment; filename="two-state-casino.apk"

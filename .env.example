# Copy to .env (cp .env.example .env) and edit.

# Your domain. Point its DNS A record at this server's IP address first.
DOMAIN=casino.example.com

# --- optional (remove the leading # to change) ---
# "closed" stops new sign-ups; existing players can still play
# REGISTRATION=open
# Starting balances of a new player
# START_TOKENS=0
# START_DOLLARS=5008159
# START_COINS=74
# Largest single transfer
# MAX_TRANSFER_TOKENS=10000000
# MAX_TRANSFER_DOLLARS=100000000
# Accounts per IP address per 24 h (0 = unlimited) and sign-up attempts per minute
# REGISTRATIONS_PER_IP=30
# REGISTER_PER_MINUTE=10
# Print one line per API request
# LOG_REQUESTS=1
# Behind Cloudflare: take the player's IP from this header
# CLIENT_IP_HEADER=cf-connecting-ip
# Operator commands over HTTP (node server/node/admin-cli.js --remote ...), at least 24 characters
# ADMIN_TOKEN=
# Voice chat (稼ぎに招待): optional TURN server for players behind strict networks
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# or Cloudflare Realtime TURN (free up to 1,000 GB a month)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# 開発者支援 (real money for ロイヤルコイン through Stripe; README「開発者支援（課金）を始める」)
# A restricted key (rk_live_...) with Checkout Sessions: write and PaymentIntents: read is enough.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_URL=https://casino.example.com
# PAY_METHODS=paypay,konbini
# PAY_DAILY_LIMIT=10000
# 特定商取引法に基づく表記 (/law)
# SELLER_NAME=
# SELLER_HEAD=
# SELLER_ADDRESS=
# SELLER_PHONE=
# SELLER_EMAIL=
# SELLER_HOURS=
# The developer's vault (MB in all, MB per file: 1024 / 300 here; 51200 /
# 2000 on Cloudflare with an R2 bucket, where a piece can be up to 16 MB)
# VAULT_MAX_MB=1024
# VAULT_FILE_MB=300
# VAULT_PIECE_MB=1
# The operator site's サーバー tab: the Cloudflare plan (free / paid) for its
# allowances and prices, and Cloudflare's own figures (an Account Analytics
# read token)
# CF_PLAN=free
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

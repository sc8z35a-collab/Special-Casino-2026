{
  "name": "two-state-casino",
  "version": "2.0.0",
  "private": true,
  "description": "BLOCKBUSTER REELS online: the game, its Cloudflare Worker and the Node server",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:dist && wrangler deploy --config dist/release/wrangler.jsonc",
    "start": "node --disable-warning=ExperimentalWarning server/node/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=4 server/test/*.test.js",
    "predev": "node tools/sync_devunit_readme.cjs",
    "predeploy": "node tools/sync_devunit_readme.cjs",
    "prestart": "node tools/sync_devunit_readme.cjs",
    "build:dist": "node tools/build-dist.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsonc-parser": "^3.3.1",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "wrangler": "4.152.0"
  }
}
